  "settings": [
    {
      "key": "bilibiliQuality",
      "title": "哔哩哔哩画质",
      "description": "「最高」不含 HDR 与杜比视界；「每次询问」会列出全部画质与编码供选择；账号没有的画质自动降级。",
      "type": "string",
